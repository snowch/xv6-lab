+	#[test]
+	fn software_interrupt_ack_preserves_a_new_external_interrupt() {
+		let mut cpu = create_cpu();
+		cpu.privilege_mode = PrivilegeMode::Supervisor;
+		cpu.write_csr_raw(CSR_MIP_ADDRESS, MIP_SSIP);
+		let ack = cpu.read_csr_raw(CSR_SIP_ADDRESS) & !MIP_SSIP;
+		// A disk completion arrives between xv6's r_sip() and w_sip().
+		cpu.write_csr_raw(CSR_MIP_ADDRESS, MIP_SSIP | MIP_SEIP);
+		assert!(cpu.write_csr(CSR_SIP_ADDRESS, ack).is_ok());
+		assert_eq!(cpu.read_csr_raw(CSR_MIP_ADDRESS), MIP_SEIP);
+	}
+
+	#[test]
+	fn sip_cannot_forge_hardware_pending_bits() {
+		let mut cpu = create_cpu();
+		cpu.privilege_mode = PrivilegeMode::Supervisor;
+		assert!(cpu.write_csr(CSR_SIP_ADDRESS, MIP_SSIP | MIP_STIP | MIP_SEIP).is_ok());
+		assert_eq!(cpu.read_csr_raw(CSR_MIP_ADDRESS), MIP_SSIP);
+	}
+
+	#[test]
+	fn sip_ack_preserves_timer_and_machine_pending_bits() {
+		let mut cpu = create_cpu();
+		let hardware = MIP_STIP | MIP_SEIP | MIP_MSIP | MIP_MTIP | MIP_MEIP;
+		cpu.write_csr_raw(CSR_MIP_ADDRESS, hardware | MIP_SSIP);
+		assert!(cpu.write_csr(CSR_SIP_ADDRESS, 0).is_ok());
+		assert_eq!(cpu.read_csr_raw(CSR_MIP_ADDRESS), hardware);
+	}
