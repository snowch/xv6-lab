+#[cfg(test)]
+mod page_permissions_tests {
+	use super::*;
+	use terminal::DummyTerminal;
+	fn mapped(user: bool, permissions: u64, mode: PrivilegeMode) -> Mmu {
+		let mut mmu = Mmu::new(Xlen::Bit64, Box::new(DummyTerminal::new()));
+		mmu.init_memory(4 * 4096);
+		mmu.store_doubleword_raw(DRAM_BASE, (((DRAM_BASE + 4096) >> 12) << 10) | 1);
+		mmu.store_doubleword_raw(DRAM_BASE + 4096, (((DRAM_BASE + 8192) >> 12) << 10) | 1);
+		mmu.store_doubleword_raw(DRAM_BASE + 8192, (((DRAM_BASE + 12288) >> 12) << 10) | permissions | if user { 16 } else { 0 } | 1);
+		mmu.ppn = DRAM_BASE >> 12;
+		mmu.update_addressing_mode(AddressingMode::SV39);
+		mmu.update_privilege_mode(mode);
+		mmu
+	}
+	#[test]
+	fn user_cannot_read_write_or_execute_supervisor_pages() {
+		let mut mmu = mapped(false, 2 | 4 | 8, PrivilegeMode::User);
+		for access in [MemoryAccessType::Read, MemoryAccessType::Write, MemoryAccessType::Execute] {
+			assert_eq!(mmu.translate_address(0, &access), Err(()));
+		}
+	}
+	#[test]
+	fn user_can_access_permitted_user_pages() {
+		let mut mmu = mapped(true, 2 | 4 | 8, PrivilegeMode::User);
+		for access in [MemoryAccessType::Read, MemoryAccessType::Write, MemoryAccessType::Execute] {
+			assert_eq!(mmu.translate_address(0, &access), Ok(DRAM_BASE + 12288));
+		}
+	}
+	#[test]
+	fn supervisor_sum_allows_user_data_but_never_user_execution() {
+		let mut mmu = mapped(true, 2 | 4 | 8, PrivilegeMode::Supervisor);
+		assert_eq!(mmu.translate_address(0, &MemoryAccessType::Read), Err(()));
+		assert_eq!(mmu.translate_address(0, &MemoryAccessType::Write), Err(()));
+		mmu.update_mstatus(1 << 18);
+		assert_eq!(mmu.translate_address(0, &MemoryAccessType::Read), Ok(DRAM_BASE + 12288));
+		assert_eq!(mmu.translate_address(0, &MemoryAccessType::Write), Ok(DRAM_BASE + 12288));
+		assert_eq!(mmu.translate_address(0, &MemoryAccessType::Execute), Err(()));
+	}
+	#[test]
+	fn sum_change_invalidates_a_cached_user_data_translation() {
+		let mut mmu = mapped(true, 2 | 4 | 8, PrivilegeMode::Supervisor);
+		mmu.page_cache_enabled = true;
+		mmu.update_mstatus(1 << 18);
+		assert!(mmu.translate_address(0, &MemoryAccessType::Read).is_ok());
+		mmu.update_mstatus(0);
+		assert_eq!(mmu.translate_address(0, &MemoryAccessType::Read), Err(()));
+	}
+	#[test]
+	fn mxr_controls_reads_from_execute_only_pages_and_flushes_cache() {
+		let mut mmu = mapped(true, 8, PrivilegeMode::User);
+		mmu.page_cache_enabled = true;
+		assert_eq!(mmu.translate_address(0, &MemoryAccessType::Read), Err(()));
+		mmu.update_mstatus(1 << 19);
+		assert!(mmu.translate_address(0, &MemoryAccessType::Read).is_ok());
+		mmu.update_mstatus(0);
+		assert_eq!(mmu.translate_address(0, &MemoryAccessType::Read), Err(()));
+	}
+}
